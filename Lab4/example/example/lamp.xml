<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
clock x;
chan press;</declaration>
	<template>
		<name x="5" y="5">Lamp</name>
		<declaration>// Place local declarations here.
</declaration>
		<location id="id0" x="-136" y="8">
			<name x="-146" y="-26">off</name>
		</location>
		<location id="id1" x="34" y="8">
			<name x="24" y="-26">low</name>
		</location>
		<location id="id2" x="263" y="8">
			<name x="253" y="-26">high</name>
		</location>
		<init ref="id0"/>
		<transition id="id3">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="guard" x="-67" y="25">x&gt;=5</label>
			<label kind="synchronisation" x="-67" y="42">press?</label>
			<nail x="0" y="59"/>
			<nail x="-85" y="59"/>
		</transition>
		<transition id="id4">
			<source ref="id2"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="-101" y="144">press?</label>
			<nail x="263" y="161"/>
			<nail x="-119" y="161"/>
		</transition>
		<transition id="id5">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="52" y="-26">x&lt;5</label>
			<label kind="synchronisation" x="52" y="-9">press?</label>
		</transition>
		<transition id="id6">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-101" y="-76">press?</label>
			<label kind="assignment" x="-101" y="-59">x:=0</label>
			<nail x="-136" y="-8"/>
			<nail x="-119" y="-59"/>
			<nail x="-17" y="-59"/>
		</transition>
	</template>
	<template>
		<name>User</name>
		<location id="id7" x="0" y="0">
			<name x="-10" y="-34">idle</name>
		</location>
		<init ref="id7"/>
		<transition id="id8">
			<source ref="id7"/>
			<target ref="id7"/>
			<label kind="synchronisation" x="18" y="-63">press!</label>
			<nail x="136" y="-93"/>
			<nail x="110" y="76"/>
		</transition>
	</template>
	<system>// Place template instantiations here.

// List one or more processes to be composed into a system.
system Lamp, User;
</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2024-12-06 10:58:15 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; x&gt;=10</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2024-12-06 10:58:29 +0100">
			</result>
		</query>
		<query>
			<formula>E[] User.idle and Lamp.low</formula>
			<comment/>
			<result outcome="failure" type="quality" timestamp="2024-12-06 10:59:50 +0100">
			</result>
		</query>
	</queries>
</nta>
